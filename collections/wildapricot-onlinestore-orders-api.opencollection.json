                "description": "Invoice status"
              },
              {
                "name": "From",
                "value": "",
                "type": "query",
                "description": "Start date of the range"
              },
              {
                "name": "To",
                "value": "",
                "type": "query",
                "description": "End of the range"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
