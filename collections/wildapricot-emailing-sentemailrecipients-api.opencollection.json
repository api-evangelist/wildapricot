{
  "opencollection": "1.0.0",
  "info": {
    "name": "WildApricot Admin Accounts Emailing.SentEmailRecipients API",
    "version": "7.24.0"
  },
  "items": [
    {
      "info": {
        "name": "Emailing.SentEmailRecipients",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "WildApricot Sent Email Recipients",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wildapricot.org/v2.2/accounts/:accountId/SentEmailRecipients",
            "params": [
              {
                "name": "emailId",
                "value": "",
                "type": "query",
                "description": "sent email Id (from email Log)"
              },
              {
                "name": "LoadLinks",
                "value": "",
                "type": "query",
                "description": "load clicked links information"
              },
              {
                "name": "Delivered",
                "value": "",
                "type": "query",
                "description": "load delivered or not delivered only"
              },
              {
                "name": "Opened",
                "value": "",
                "type": "query",
                "description": "load opened or not opened only"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://oauth.wildapricot.org/auth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Sent email recipients"
        }
      ]
    }
  ],
  "bundled": true
}