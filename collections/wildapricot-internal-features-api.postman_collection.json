                  "disabled": false,
                  "key": "",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "featureId",
                  "description": "(Required) feature identifier"
                }
              ]
            },
            "header": [
